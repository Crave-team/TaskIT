# Copy to .env (or set these in your hosting dashboard). The server reads process.env.
# `npm run dev` loads this file for you; in production set the variables on the host instead.
#
# LOCAL DEVELOPMENT on http://localhost: change NODE_ENV to development and COOKIE_SECURE to false below.

NODE_ENV=production
PORT=3000

# MongoDB connection string (Atlas, or mongodb://127.0.0.1:27017/taskit for a local mongod)
MONGODB_URI=mongodb://127.0.0.1:27017/taskit

# Multi-document transactions need a replica set (Atlas has one; a plain local mongod does not).
# true  -> account deletion, team disbanding, project deletion... are all-or-nothing
# false -> each write is still atomic; cascades are ordered so a half-finished run can be repeated
MONGO_TRANSACTIONS=false

# REQUIRED in production: the server refuses to start with the public default.
ADMIN_INVITE_CODE=change-me-to-a-long-random-string

# EMAIL CODES (on by default): after the password, a 6-digit code is emailed and must be entered. This applies to
# sign-in AND sign-up (an account is only created once its email address has proven itself).
# EMAIL_CODE_REQUIRED=true     # false = optional: each person can turn it on in Settings
#
# Sending the emails through a Gmail account (free, about 500 emails a day):
#   1. Turn on 2-Step Verification for that Google account (myaccount.google.com/security).
#   2. Create an "App password" at myaccount.google.com/apppasswords (16 letters). Use THAT here, never your Gmail password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=abcdefghijklmnop
# MAIL_FROM=TaskIT <yourname@gmail.com>
#
# With NODE_ENV=development and no SMTP_* set, codes are PRINTED IN THE SERVER WINDOW instead of emailed, so you can
# try everything locally. In production the server refuses to start while codes are required but SMTP is not set up.

# "Sign in with Google" for members and admins (optional; leave empty to hide the button).
# Google Cloud Console -> Google Auth Platform -> Clients -> Create client -> Web application.
# Add your site (e.g. https://app.example.com and http://localhost:5173 for dev) under "Authorized JavaScript origins".
# GOOGLE_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com

# Only if the browser app is served from a DIFFERENT origin than this server (CORS)
# CLIENT_ORIGIN=https://app.example.com

# Behind a reverse proxy / load balancer (needed for correct client IPs in rate limiting)
# TRUST_PROXY=1
# Sessions no longer use a cookie; this only controls removal of the old session cookie from earlier versions.
COOKIE_SECURE=true
SESSION_MAX_DAYS=30

# Where uploaded files are stored (give this a persistent volume), and where the built front end lives
UPLOAD_DIR=./uploads
# STATIC_DIR=../dist
